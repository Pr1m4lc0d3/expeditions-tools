                    ],
                    "open_loot": {
                        "zone": "det_pickup",
                        "item": "Remote_Detonation_Device",
                        "type": 14
                    }
                },
                {
                    "take": [
                        {
                            "zone": "det_pickup",
                            "item": "Remote_Detonation_Device",
                            "type": 14,
                            "text": "Step 3 of 5: Load the detonator onto your truck at the carport",
                            "message": "Detonator loaded. Next: drive it to the rock and unload it there."
                        }
                    ]
                },
                {
                    "deliver": [
                        {
                            "zone": "det_block",
                            "item": "Remote_Detonation_Device",
                            "type": 14,
                            "text": "Step 4 of 5: Unload the detonator at the rock",
                            "message": "Detonator set. Next: unload 100 fuel at the rock to set it off."
